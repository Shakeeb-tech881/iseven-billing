# Copy to .env.local for local use, or paste into Vercel Environment Variables.

# --- database ---------------------------------------------------------
# Supabase -> Settings -> Database -> Connection string
# On Vercel use the TRANSACTION pooler (port 6543).
# Locally use the SESSION pooler (port 5432).
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- logins -----------------------------------------------------------
# Two roles, two passwords. If BOTH are unset there is no login at all.
ADMIN_PASSWORD=long-admin-password-here
CASHIER_PASSWORD=different-cashier-password

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-32-plus-random-characters

# --- email ------------------------------------------------------------
# Brevo: SMTP & API -> SMTP. The key is NOT your Brevo login password.
# Leave SMTP_HOST blank to switch sending off entirely.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM=I7SEVEN MOBILE <info@iseven.lk>
MAIL_REPLY_TO=info@iseven.lk
